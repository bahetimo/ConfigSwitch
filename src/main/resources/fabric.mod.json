{
  "schemaVersion": 1,
  "id": "configswitch",
  "version": "${version}",
  "name": "ConfigSwitch",
  "description": "Synchronize your mod configs and options.txt between modpacks. Push your tuned settings to a global repository once, then fetch them into any other instance.",
  "authors": ["bahetimo"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/configswitch/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "com.bteamore.configswitch.client.ConfigswitchDataGenerator"
    ],
    "client": [
      "com.bteamore.configswitch.client.ConfigswitchClient"
    ],
    "main": [
      "com.bteamore.configswitch.Configswitch"
    ]
  },
  "mixins": [
    "configswitch.mixins.json",
    {
      "config": "configswitch.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_min_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
